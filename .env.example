# Copy to .env (which is gitignored). Credentials are never hardcoded.

# Any Anthropic-Messages-compatible endpoint:
#   - https://api.anthropic.com/v1/messages           (Anthropic directly)
#   - https://your-proxy/v1/messages                  (self-hosted Anthropic<->OpenAI proxy
#                                                       in front of a local Qwen/Llama)
AGENT_API_URL=https://api.anthropic.com/v1/messages

# Your API key for the endpoint above.
AGENT_API_KEY=replace-me
